# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Twilio WhatsApp (Twilio API — NOT Meta Cloud API)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
# Twilio sandbox number (dev): whatsapp:+14155238886
# Production: whatsapp:+31xxxxxxxxx

# Meta WhatsApp Business API (alternative to Twilio)
META_WA_ACCESS_TOKEN=your-meta-system-user-token
# Default phone number ID (overridable per tenant via tenant_integrations.config)
META_WA_PHONE_NUMBER_ID=your-phone-number-id

# Email notifications (Resend) — channel is skipped entirely when unset.
# EMAIL_FROM_ADDRESS must belong to a Resend-verified sending domain.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
EMAIL_FROM_ADDRESS=bookings@mail.bookit.monoliet.cloud

# Payments (Mollie) — platform-wide fallback key. Tenants may set their own
# key per-tenant under Settings → Integrations → Mollie; this is used only
# when a tenant has an active Mollie integration but no own key. Unset =
# deposit checkout links are simply not generated (booking still confirms).
MOLLIE_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Maps (optional — widget degrades gracefully without this)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Cron jobs (set to 'true' to enable reminder cron in development)
ENABLE_CRON=false

# Super Admin API key (for /api/super-admin/* routes)
SUPER_ADMIN_API_KEY=your-super-admin-key

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
